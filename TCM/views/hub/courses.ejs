<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>All Courses | DBW HUB</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="bg-[#f7f7f8] text-gray-900">

  <%- include("../partials/header") %>

  <!-- DBW HUB TOP BAR -->
  <section class="bg-gradient-to-r from-[#4F46E5] via-[#7C3AED] to-[#C026D3] text-white">
    <div class="max-w-7xl mx-auto px-6 md:px-16 py-10 md:py-12">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
        <div>
          <h1 class="text-3xl md:text-5xl font-extrabold mb-3">DBW HUB</h1>
          <p class="text-lg md:text-2xl text-white/90">Your Online Learning Platform</p>
        </div>

        <% if (!isLoggedIn) { %>
          <a
            href="#"
            class="open-auth-modal inline-flex items-center justify-center rounded-2xl bg-white text-[#4F46E5] px-8 py-4 text-lg font-semibold shadow-sm hover:shadow-md transition self-start lg:self-auto"
            data-modal-mode="login"
            data-redirect-after-auth="/hub/courses"
          >
            Sign In / Register
          </a>
        <% } else { %>
          <a
            href="/hub/documents"
            class="inline-flex items-center justify-center rounded-2xl bg-white text-[#4F46E5] px-8 py-4 text-lg font-semibold shadow-sm hover:shadow-md transition self-start lg:self-auto"
          >
            My Documents
          </a>
        <% } %>
      </div>
    </div>

    <div class="border-t border-white/15">
      <div class="max-w-7xl mx-auto px-6 md:px-16">
        <div class="flex items-center gap-8 overflow-x-auto">
          <a href="/hub/courses" class="inline-flex h-14 items-center border-b-2 border-white text-white font-semibold whitespace-nowrap">
            <span class="mr-2">📖</span>
            Courses
          </a>
          <a href="/hub/documents" class="inline-flex h-14 items-center border-b-2 border-transparent text-white/70 font-medium whitespace-nowrap hover:text-white transition">
            <span class="mr-2">📄</span>
            Documents
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- PAGE INTRO -->
  <section class="pt-12 md:pt-14 pb-10">
    <div class="max-w-7xl mx-auto px-6 md:px-16">
      <h2 class="text-4xl md:text-5xl font-extrabold text-gray-950 mb-4">
        Available Courses
      </h2>
      <p class="text-lg md:text-2xl text-slate-600 max-w-4xl">
        Explore the courses available on DBW HUB and open each course to view study documents, audio teachings, and assignments.
      </p>
    </div>
  </section>

  <!-- COURSES GRID -->
  <section class="pb-16 md:pb-20">
    <div class="max-w-7xl mx-auto px-6 md:px-16">
      <% if (!allCourses || !allCourses.length) { %>
        <div class="rounded-[26px] border border-gray-200 bg-white p-10 text-center shadow-sm">
          <h3 class="text-2xl md:text-3xl font-extrabold text-gray-950 mb-3">
            No courses available yet
          </h3>
          <p class="text-lg text-slate-600">
            Courses created by the admin will appear here automatically.
          </p>
        </div>
      <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
          <% allCourses.forEach((course) => { %>
            <article class="bg-white border border-indigo-100 rounded-[26px] shadow-sm overflow-hidden">
              <div class="relative h-56 overflow-hidden">
                <img
                  src="<%= course.image || '/images/event1.jpg' %>"
                  alt="<%= course.title %>"
                  class="w-full h-full object-cover"
                />

                <% if (course.price) { %>
                  <span class="absolute top-4 right-4 rounded-full bg-[#4F46E5] text-white px-4 py-2 text-base font-semibold shadow">
                    <%= course.price %>
                  </span>
                <% } %>
              </div>

              <div class="p-6 md:p-7">
                <h3 class="text-2xl font-extrabold text-gray-950 mb-4 leading-snug">
                  <%= course.title %>
                </h3>

                <p class="text-lg leading-relaxed text-slate-700 mb-5 line-clamp-3">
                  <%= course.description %>
                </p>

                <div class="flex flex-wrap items-center gap-5 text-base text-slate-600 mb-5">
                  <span class="inline-flex items-center gap-2">
                    <span>🕒</span>
                    <%= course.duration || "Not specified" %>
                  </span>

                  <span class="inline-flex items-center gap-2">
                    <span>▶</span>
                    <%= course.lessons || "Not specified" %>
                  </span>

                  <span class="inline-flex items-center gap-2">
                    <span>👥</span>
                    <%= course.students || "0" %>
                  </span>
                </div>

                <div class="flex items-center justify-between gap-4 mb-6">
                  <div class="inline-flex items-center gap-2 text-lg font-semibold text-gray-900">
                    <span class="text-yellow-500">★</span>
                    <span><%= course.rating || "0" %></span>
                  </div>

                  <p class="text-base text-slate-500 text-right">
                    <%= course.instructor || "Not assigned" %>
                  </p>
                </div>

                <div class="flex flex-wrap gap-3 mb-6 text-sm text-slate-600">
                  <span class="inline-flex rounded-full bg-indigo-50 px-3 py-1.5 font-medium">
                    <%= course.courseDocuments ? course.courseDocuments.length : 0 %> document(s)
                  </span>
                  <span class="inline-flex rounded-full bg-purple-50 px-3 py-1.5 font-medium">
                    <%= course.courseAudios ? course.courseAudios.length : 0 %> audio(s)
                  </span>
                  <span class="inline-flex rounded-full bg-pink-50 px-3 py-1.5 font-medium">
                    <%= course.assignmentDocument && course.assignmentDocument.fileUrl ? 1 : 0 %> assignment
                  </span>
                </div>

                <a
                  href="/hub/courses/<%= course.slug %>"
                  class="w-full inline-flex items-center justify-center rounded-2xl text-white px-6 py-4 text-lg font-semibold transition <%= course.buttonClass || 'bg-[#4F46E5] hover:bg-indigo-700' %>"
                >
                  <%= course.buttonText || "View Course" %>
                </a>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </div>
  </section>

  <!-- HELP SECTION -->
  <section class="pb-20 md:pb-24">
    <div class="max-w-7xl mx-auto px-6 md:px-16">
      <div class="rounded-[28px] border border-indigo-100 bg-indigo-50/70 p-8 md:p-10">
        <h3 class="text-3xl md:text-4xl font-extrabold text-gray-950 mb-4">
          🎓 Need Help Choosing a Course?
        </h3>
        <p class="text-lg md:text-[1.15rem] text-slate-700 leading-relaxed mb-6">
          Not sure where to start? Contact our academic advisor for personalized course recommendations based on your spiritual goals and ministry calling.
        </p>

        <a
          href="/contact"
          class="inline-flex items-center justify-center rounded-2xl bg-[#4F46E5] text-white px-8 py-4 text-lg font-semibold hover:bg-indigo-700 transition shadow-sm"
        >
          Contact Advisor
        </a>
      </div>
    </div>
  </section>

  <%- include("../partials/footer") %>
  <%- include("../partials/auth-modal") %>
  <script src="/js/auth-modal.js"></script>

</body>
</html>