<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Town Crier</title>
<link rel="stylesheet" href="/css/style.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>

<body class="bg-[#f7f7f8] text-gray-900">

<%- include("partials/header") %>

<!-- HERO SECTION -->
<section class="relative h-screen w-full overflow-hidden">

  <!-- SLIDE 1 -->
  <div class="hero-slide absolute inset-0 opacity-100 transition-opacity duration-1000">
    <img src="/images/hero1.jpg" class="w-full h-full object-cover" />

    <div class="absolute inset-0 bg-black/60"></div>

    <div class="absolute inset-0 flex items-center justify-center text-center text-white px-4">
      <div>
        <h1 class="text-5xl md:text-6xl font-bold mb-4">Youth Revival Night</h1>
        <p class="text-lg md:text-xl">Raising a generation for Christ</p>
      </div>
    </div>
  </div>

  <!-- SLIDE 2 -->
  <div class="hero-slide absolute inset-0 opacity-0 transition-opacity duration-1000">
    <img src="/images/hero2.jpg" class="w-full h-full object-cover" />

    <div class="absolute inset-0 bg-black/60"></div>

    <div class="absolute inset-0 flex items-center justify-center text-center text-white px-4">
      <div>
        <h1 class="text-5xl md:text-6xl font-bold mb-4">Sunday Worship</h1>
        <p class="text-lg md:text-xl">Encounter the presence of God</p>
      </div>
    </div>
  </div>

  <!-- SLIDE 3 -->
  <div class="hero-slide absolute inset-0 opacity-0 transition-opacity duration-1000">
    <img src="/images/hero3.jpg" class="w-full h-full object-cover" />

    <div class="absolute inset-0 bg-black/60"></div>

    <div class="absolute inset-0 flex items-center justify-center text-center text-white px-4">
      <div>
        <h1 class="text-5xl md:text-6xl font-bold mb-4">Community Outreach</h1>
        <p class="text-lg md:text-xl">Touching lives with the love of Christ</p>
      </div>
    </div>
  </div>

</section>

<!-- MISSION SECTION -->
<section class="w-full bg-white">

  <div class="max-w-7xl mx-auto px-6 md:px-16 py-16 md:py-24">

    <div class="flex flex-col md:flex-row md:items-center md:gap-12">

      <!-- IMAGE -->
      <div class="w-full md:w-1/2">
        <img 
          src="/images/mission.jpg" 
          alt="Mission Image"
          class="w-full h-auto md:h-[500px] object-cover rounded-2xl"
        >
      </div>

      <!-- TEXT -->
<div class="w-full md:w-1/2 mt-8 md:mt-0">

  <p id="section-label" class="text-primary font-semibold uppercase tracking-wide mb-3">
    OUR MISSION
  </p>

  <h2 id="section-title" class="text-3xl md:text-5xl font-bold mb-5 leading-tight">
    Building Kingdom Leaders
  </h2>

  <p id="section-text" class="text-gray-600 text-base md:text-lg leading-relaxed mb-6">
    Our mission is to develop Christ-centered leaders who will impact their communities and nations.
  </p>

  <a href="#"
     class="inline-flex items-center bg-primary text-white px-6 py-3 rounded-full">
    Explore Our Ministries
    <span class="ml-2">→</span>
  </a>

</div>

    </div>

  </div>

</section>

<!-- UPCOMING EVENTS SECTION --> 
<section class="bg-gray-50 py-20 px-6 md:px-16">

  <!-- SECTION HEADER -->
  <div class="text-center mb-16">
    <p class="text-purple-600 font-semibold uppercase tracking-wide mb-2">
      Upcoming Events
    </p>
    <h2 class="text-3xl md:text-5xl font-bold text-gray-900">
      Join Our Programs
    </h2>
  </div>

  <!-- EVENT CARDS -->
  <div class="grid gap-10 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3">

    <!-- CARD 1 -->
    <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:scale-105 transition duration-300">
      <img src="/images/event1.jpg" class="w-full h-56 object-cover">

      <div class="p-6">
        <p class="text-sm text-purple-600 font-semibold mb-2">March 25, 2026</p>
        <h3 class="text-xl font-bold mb-3">Youth Revival Night</h3>
        <p class="text-gray-600 mb-4">
          A powerful night of worship, word, and revival for young believers.
        </p>
        <a href="#" class="text-purple-600 font-semibold">
          Learn More →
        </a>
      </div>
    </div>

    <!-- CARD 2 -->
    <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:scale-105 transition duration-300">
      <img src="/images/event2.jpg" class="w-full h-56 object-cover">

      <div class="p-6">
        <p class="text-sm text-purple-600 font-semibold mb-2">March 28, 2026</p>
        <h3 class="text-xl font-bold mb-3">Sunday Worship</h3>
        <p class="text-gray-600 mb-4">
          Join us for a life-transforming worship experience in God's presence.
        </p>
        <a href="#" class="text-purple-600 font-semibold">
          Learn More →
        </a>
      </div>
    </div>

    <!-- CARD 3 -->
    <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:scale-105 transition duration-300">
      <img src="/images/event3.jpg" class="w-full h-56 object-cover">

      <div class="p-6">
        <p class="text-sm text-purple-600 font-semibold mb-2">April 2, 2026</p>
        <h3 class="text-xl font-bold mb-3">Community Outreach</h3>
        <p class="text-gray-600 mb-4">
          Reaching out with love, impacting lives, and serving our community.
        </p>
        <a href="#" class="text-purple-600 font-semibold">
          Learn More →
        </a>
      </div>
    </div>

  </div>

  <!-- VIEW ALL BUTTON -->
  <div class="text-center mt-12">
    <a href="/events"
       class="inline-block bg-purple-600 text-white px-8 py-3 rounded-full font-semibold hover:bg-purple-700 transition duration-300">
      View All Events →
    </a>
  </div>

</section>


<%- include("partials/footer") %>

<script src="/js/heroSlider.js"></script>

<script>
  const sections = [
    {
      label: "OUR MISSION",
      title: "Building Kingdom Leaders",
      text: "Our mission is to develop Christ-centered leaders who will impact their communities and nations."
    },
    {
      label: "OUR VISION",
      title: "Raising a Global Movement",
      text: "We envision a generation passionate about God, transforming societies through faith and purpose."
    },
    {
      label: "OUR VALUES",
      title: "Rooted in Christ",
      text: "We are committed to truth, love, excellence, and spiritual growth in all we do."
    }
  ];

  let index = 0;

  setInterval(() => {
    index = (index + 1) % sections.length;

    document.getElementById("section-label").textContent = sections[index].label;
    document.getElementById("section-title").textContent = sections[index].title;
    document.getElementById("section-text").textContent = sections[index].text;

  }, 4000); // every 4 seconds
</script>

</body>

</html>